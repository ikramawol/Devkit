{
  "hero": {
    "eyebrow": "# open source developer setup kit",
    "title": [
      "New laptop?",
      "Ready in minutes."
    ],
    "text": "dkit installs your tools, scaffolds full-stack projects and moves your entire dev environment to a new PC or OS, including between Windows, macOS and Linux. It plans first, asks you to confirm, then acts.",
    "install": {
      "npm": "npm install -g devsetupkit-cli",
      "pnpm": "pnpm add -g devsetupkit-cli",
      "yarn": "yarn global add devsetupkit-cli",
      "bun": "bun add -g devsetupkit-cli"
    },
    "note": "Needs Node.js 20+. Installs the dkit command. Free and MIT licensed."
  },
