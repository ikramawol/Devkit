{
  "name": "devsetupkit-cli",
  "version": "0.2.0",
  "description": "Set up a developer machine with one command, and move your setup to a new PC or OS",
  "license": "MIT",
  "author": "ikramawol",
  "keywords":["cli", "developer-tools", "setup", "winget", "homebrew", "migrate", "dotfiles"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramawol/Devkit.git"
  },
  "type": "module",
  "bin": {
    "dkit": "dist/index.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
