{
  "name": "devsetupkit-cli",
  "version": "0.2.2",
  "description": "Set up a developer machine with one command, and move your setup to a new PC or OS",
  "license": "MIT",
  "author": "ikramawol",
  "keywords": [
    "cli",
    "developer-tools",
    "setup",
    "winget",
    "homebrew",
    "migrate",
    "dotfiles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramawol/Devkit.git"
  },
  "type": "module",
  "bin": {
    "dkit": "dist/index.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  }
}
